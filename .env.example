# ---------- CRM online (Supabase pessoal) ----------
# Painel do Supabase > Project Settings > API. Use a chave PÚBLICA (publishable ou anon), nunca a secreta:
# ela vai para o navegador, e quem protege os dados é a RLS do banco.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Endereço do site publicado (Netlify ou Cloudflare Pages), para o atalho "CRM online" na tela do PC
WEB_URL=

# ---------- Parte do PC ----------
# Senha do Postgres do docker-compose. Use só letras e números: ela entra numa URL de conexão.
POSTGRES_PASSWORD=troque-esta-senha

# Porta e interface da tela local. Mantenha 127.0.0.1: ela não tem login próprio.
PORT=3000
HOST=127.0.0.1
# Hosts aceitos no cabeçalho Host (proteção contra DNS rebinding)
ALLOWED_HOSTS=localhost,127.0.0.1
# Endereço da API do gosom/google-maps-scraper rodando com -web
SCRAPER_URL=http://localhost:8080
# Buscas do Google Maps guardadas no PC até serem enviadas ao kanban
DATA_FILE=data/local.json
# Intervalo em ms para conferir o andamento das buscas
POLL_MS=15000

# Prospecção por CNPJ fora do Docker. Use UMA das opções:
# 1 = demonstração com empresas fictícias em memória (não precisa de banco)
CNPJ_DEMO=1
# Postgres com a migration db-local/migrations aplicada e a base carregada
# CNPJ_DATABASE_URL=postgres://usuario:senha@host:5432/postgres

# Usada só pelo importador (npm run importar:cnpj). No Docker o compose já preenche.
# DATABASE_URL=postgres://usuario:senha@host:5432/postgres
